{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storage Local",
  "version": "0.1.0",
  "identifier": "com.storagelocal.vault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Storage Local — Personal Credential Vault",
        "width": 1160,
        "height": 760,
        "minWidth": 880,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
